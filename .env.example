# Discord bot credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=APPLICATION_CLIENT_ID

# Database — Sequel URL. SQLite (default) or Postgres.
# SQLite:
DATABASE_URL=sqlite://db/eros.db
# SQLITE_PATH=db/eros.db
#
# Postgres (Ptero / hosted). URL-encode special chars in the password.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Optional: ?sslmode=require if the host demands TLS

# Optional
# BOT_PREFIX=e,   # the uppercase form (E,) also works, for mobile auto-capitalisation
# EROS_SQL_LOG=1
# DISCORD_GUILD_ID=   # if set, `rake commands:register` writes guild commands (instant)

# Owner's Discord user ID — full e,dev access and the Sin Sculptor title (blank = no owner)
DEVELOPER_ID=
# Comma-separated Discord user IDs allowed to use e,dev commands (in addition to the owner)
BUG_TESTER_IDS=

# Bot status ("Playing with X users in Y towers.") refresh interval in seconds (min 30)
# PRESENCE_REFRESH_SECONDS=120
# Instant updates on member join/leave. Only set true after enabling "Server Members Intent"
# in the Discord Developer Portal (Bot tab) — otherwise the bot cannot connect.
# SERVER_MEMBERS_INTENT=false

# Error reports are posted to this channel (blank = console + logs/errors.log only).
# If ERROR_GUILD_ID is set, the channel must belong to that server.
ERROR_GUILD_ID=
ERROR_CHANNEL_ID=

# Join/leave notices (server name, members, owner, icon). Defaults to the
# support-server guild-log channel. Bot needs Send Messages + Embed Links there.
# GUILD_LOG_CHANNEL_ID=1564014755595948213

# Support-server Discord perks (tag + booster). Detected even in DMs / other
# servers via the support guild membership. Tag +5% LP; booster +5% LP,
# 10% off all LP prices, and +1 Lich's Phylactery use per run.
# Falls back to ERROR_GUILD_ID, then the Endless Ruins support server id.
# SUPPORT_GUILD_ID=1552733580067872798
# SUPPORT_BOOSTER_ROLE_ID=1562618450730553354
# SUPPORT_TAG_LP_MULT=1.05
# SUPPORT_BOOSTER_LP_MULT=1.05
# SUPPORT_BOOSTER_PRICE_MULT=0.9
