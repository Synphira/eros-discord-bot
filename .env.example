# Discord bot credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=APPLICATION_CLIENT_ID

# SQLite database — either a full Sequel URL or a filesystem path
DATABASE_URL=sqlite://db/eros.db
# SQLITE_PATH=db/eros.db

# Optional
# BOT_PREFIX=!
# EROS_SQL_LOG=1
# DISCORD_GUILD_ID=   # if set, `rake commands:register` writes guild commands (instant)
